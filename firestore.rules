rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Colección users: Gestión de usuarios del sistema
    match /users/{userId} {
      allow read, write: if true;
    }

    // Colección cases: Expedientes migratorios
    match /cases/{caseId} {
      allow read, write: if true;
    }

    // Colección files: Bóveda digital de documentos
    match /files/{fileId} {
      allow read, write: if true;
    }

    // Colección appointments: Calendario de citas
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Colección messages: Bandeja de entrada de comunicados
    match /messages/{messageId} {
      allow read, write: if true;
    }
  }
}
